{
  "manifest_version": 3,
  "name": "Career Workspace Capture",
  "version": "0.1.0",
  "description": "Detect a job application and save it only after you confirm the details.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "host_permissions": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Career Workspace Capture",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  }
}
