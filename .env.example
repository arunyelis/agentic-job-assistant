OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_BASE_URL=
PORT=3000
ENABLE_PLAYWRIGHT_MCP=true
APP_ENV=development
AUTH_MODE=local
AUTH_SECRET=replace-with-a-long-random-value
DATA_ENCRYPTION_KEY=replace-with-a-different-long-random-value
DATABASE_URL=sqlite:///data/career-workspace.db
MAX_UPLOAD_BYTES=10485760
BACKUP_RETENTION_DAYS=30
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=

# TypeSafe System One — typed judgments for job ranking.
# Optional: without a key the ranker degrades to keyword matching and says so.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_CONCURRENCY=16
# Share of the scored corpus that earns a resume-tailoring pass.
SHORTLIST_PERCENTILE=10
